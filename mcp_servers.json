{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\raghu\\Documents\\Athena"
      ]
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ]
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.notion.com/sse"
      ]
    },
    "excalidraw": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-excalidraw-server"
      ],
      "env": {
        "PORT": "3099",
        "EXPRESS_SERVER_URL": "http://127.0.0.1:3099",
        "EXCALIDRAW_NO_AUTOSTART": "1"
      }
    },
    "calendar": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-calendar-autoauth-mcp"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "browser-ref-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "browser-ref-mcp"
      ]
    }
  }
}