    "test:tools": "tsc && node dist/tests/test_phase3_tools.js",
    "test:tools_legacy": "tsc && node dist/tests/test_tools_phase2.js",
    "test:evolution": "tsc && node dist/tests/test_p3_self_evolution.js",
    "test:runtime": "tsc && node dist/tests/test_phase1_runtime.js",
    "test:context_memory": "tsc && node dist/tests/test_phase2_context_memory.js",
    "eval:benchmark": "tsc && node dist/tests/evals/runBenchmark.js",
