# Athena Environment Configuration Template
# Copy this file to .env and configure appropriate values.

# Database Configuration
# Default is 'sqlite' for zero-configuration local development.
# Set to 'postgres' for high-concurrency production deployments.
DATABASE_DRIVER=sqlite
# DATABASE_URL=postgresql://athena_user:password@localhost:5432/athena_db

# SQLite Database File Path (Optional, defaults to 'state.db')
# SQLITE_PATH=./state.db

# Platform API Server Configuration (Phase 12)
PORT=4000
HOST=0.0.0.0
ATHENA_API_KEY=athena_dev_secret_key_change_in_production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM Providers
LLM_PROVIDER=gemini # 'gemini' or 'nvidia'

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EVAL_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# NVIDIA Cloud API (Optional)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=z-ai/glm-5.2

# Observability (Langfuse - Optional)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Messaging & Channels (Telegram - Optional)
# TELEGRAM_BOT_TOKEN=123456789:ABC...
# TELEGRAM_USER_ID=123456789

# Browser Environment
BROWSER_HEADLESS=false
